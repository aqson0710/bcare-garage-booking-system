# Copy to .env (Docker / VPS) or .env.local (npm run dev). Example values only.

# --- Supabase (public: also baked into the browser bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server-only secrets (never commit real values) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SLIPOK_BRANCH_ID=your-slipok-branch-id
SLIPOK_API_KEY=your-slipok-api-key
SLIPOK_MODE=test

# --- Docker / deploy ---
# Host port (bound to 127.0.0.1). Lab app already uses 3300.
APP_PORT=3301
APP_IMAGE=ghcr.io/aqson0710/bcare-garage-booking-system:latest
